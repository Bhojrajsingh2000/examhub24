# Copy this file to .env and fill in real values. Never commit the real .env file.

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# On PythonAnywhere / production, set DEBUG=False and fill both of these in:
# ALLOWED_HOSTS=yourusername.pythonanywhere.com
# CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=
# Optional: change the admin panel path away from the default 'admin/'
# ADMIN_URL=eh-manage/

# Optional: error monitoring — sign up free at https://sentry.io, create a Django
# project, and paste its DSN here. Also run: pip install sentry-sdk
SENTRY_DSN=

# Optional: shared Redis cache (recommended for production, needed for rate-limiting to
# work correctly across multiple worker processes). Also run: pip install redis
# REDIS_URL=redis://127.0.0.1:6379/1

# Leave DATABASE_URL unset to use the default SQLite database (good for local dev).
# For PostgreSQL:  postgres://USER:PASSWORD@HOST:5432/examhub24
# For MySQL:       mysql://USER:PASSWORD@HOST:3306/examhub24
# DATABASE_URL=

# Email (leave as console backend for local dev — OTPs/emails print to your terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ExamHub24 <no-reply@examhub24.com>

# Razorpay (leave blank to use demo/instant-success payment mode for local testing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
